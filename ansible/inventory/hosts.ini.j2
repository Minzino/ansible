# Ansible Inventory Template (Generated by FastAPI backend)

[bastion]
{{ bastion_ip }} ansible_user={{ ansible_user | default('ubuntu') }}{% if bastion_port %} ansible_port={{ bastion_port }}{% endif %}{% if bastion_ssh_password %} ansible_ssh_pass={{ bastion_ssh_password }} ansible_ssh_common_args='-o StrictHostKeyChecking=no'{% endif %}

[masters]
{% for host in master_nodes %}
{{ host.name }} ansible_host={{ host.ip }} ansible_user={{ host.user | default(ansible_user | default('ubuntu')) }}{% if host.port %} ansible_port={{ host.port }}{% endif %}{% if host.ssh_password %} ansible_ssh_pass={{ host.ssh_password }} ansible_ssh_common_args='-o StrictHostKeyChecking=no'{% endif %}
{% endfor %}

[workers]
{% for host in worker_nodes %}
{{ host.name }} ansible_host={{ host.ip }} ansible_user={{ host.user | default(ansible_user | default('ubuntu')) }}{% if host.port %} ansible_port={{ host.port }}{% endif %}{% if host.ssh_password %} ansible_ssh_pass={{ host.ssh_password }} ansible_ssh_common_args='-o StrictHostKeyChecking=no'{% endif %}
{% endfor %}

[etcd]
{% for host in etcd_nodes %}
{{ host.name }} ansible_host={{ host.ip }} ansible_user={{ host.user | default(ansible_user | default('ubuntu')) }}{% if host.port %} ansible_port={{ host.port }}{% endif %}{% if host.ssh_password %} ansible_ssh_pass={{ host.ssh_password }} ansible_ssh_common_args='-o StrictHostKeyChecking=no'{% endif %}
{% endfor %}

[kube_cluster:children]
masters
workers

[all:vars]
# Variables here are globally available, but group_vars/all.yml is preferred
# Example: ansible_ssh_private_key_file=/path/to/your/private/key 
ansible_python_interpreter=/usr/bin/python3
{% if default_ssh_password %}ansible_ssh_pass={{ default_ssh_password }}{% endif %}
{% if use_ssh_password %}ansible_ssh_common_args='-o StrictHostKeyChecking=no'{% endif %} 